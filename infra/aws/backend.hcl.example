# Supply a real approved state bucket/key/region/KMS ARN before use; not deployment inputs.
bucket       = "REPLACE_WITH_APPROVED_STATE_BUCKET"
key          = "travbook/REPLACE_ENVIRONMENT/terraform.tfstate"
region       = "REPLACE_WITH_APPROVED_REGION"
encrypt      = true
use_lockfile = true
kms_key_id   = "REPLACE_WITH_APPROVED_KMS_KEY_ARN"
