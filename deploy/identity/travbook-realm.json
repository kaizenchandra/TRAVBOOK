{
  "realm": "travbook",
  "enabled": true,
  "displayName": "Travbook — local test identity",
  "sslRequired": "none",
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "rememberMe": false,
  "bruteForceProtected": true,
  "failureFactor": 5,
  "waitIncrementSeconds": 30,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 900,
  "ssoSessionMaxLifespan": 1800,
  "clientScopes": [
    {
      "name": "quotes:read",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "true"
      },
      "protocolMappers": []
    },
    {
      "name": "quotes:write",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "true"
      },
      "protocolMappers": []
    },
    {
      "name": "travbook-audience",
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "API audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "travbook-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "name": "bookings:read",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "true"
      },
      "protocolMappers": []
    },
    {
      "name": "bookings:write",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "true"
      },
      "protocolMappers": []
    }
  ],
  "clients": [
    {
      "clientId": "travbook-web",
      "name": "Travbook local preview",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://127.0.0.1:3000/login/oauth2/code/travbook"
      ],
      "webOrigins": [
        "http://127.0.0.1:3000"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://127.0.0.1:3000/account?loggedOut=true"
      },
      "defaultClientScopes": [
        "quotes:read",
        "quotes:write",
        "travbook-audience",
        "bookings:read",
        "bookings:write"
      ]
    }
  ],
  "users": [
    {
      "username": "alice",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Alice",
      "lastName": "Local Test",
      "email": "alice@example.invalid",
      "credentials": [
        {
          "type": "password",
          "value": "alice-local-only",
          "temporary": false
        }
      ],
      "id": "11111111-1111-4111-8111-111111111111"
    },
    {
      "username": "bob",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Bob",
      "lastName": "Local Test",
      "email": "bob@example.invalid",
      "credentials": [
        {
          "type": "password",
          "value": "bob-local-only",
          "temporary": false
        }
      ],
      "id": "22222222-2222-4222-8222-222222222222"
    }
  ],
  "id": "aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa"
}
