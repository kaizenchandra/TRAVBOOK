{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:travbook:events:refund:v1",
  "title": "MOCK refund events (outbox; publication pending)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "eventId",
    "eventType",
    "schemaVersion",
    "aggregateId",
    "aggregateVersion",
    "occurredAt",
    "correlationId",
    "causationId",
    "producer",
    "mode",
    "payload"
  ],
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid"
    },
    "eventType": {
      "enum": [
        "MockRefundRequested",
        "MockRefundCompleted"
      ]
    },
    "schemaVersion": {
      "const": 1
    },
    "aggregateId": {
      "type": "string",
      "format": "uuid"
    },
    "aggregateVersion": {
      "type": "integer",
      "minimum": 1
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "correlationId": {
      "type": "string",
      "format": "uuid"
    },
    "causationId": {
      "type": "string",
      "format": "uuid"
    },
    "producer": {
      "const": "payments"
    },
    "mode": {
      "const": "MOCK"
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "paymentId",
        "amount",
        "currency",
        "status"
      ],
      "properties": {
        "paymentId": {
          "type": "string",
          "format": "uuid"
        },
        "amount": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]{2}$"
        },
        "currency": {
          "const": "INR"
        },
        "status": {
          "enum": [
            "PENDING",
            "SUCCEEDED"
          ]
        }
      }
    }
  }
}
