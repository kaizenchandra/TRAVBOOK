{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "eventId",
    "aggregateId",
    "aggregateVersion",
    "eventType",
    "schemaVersion",
    "occurredAt",
    "correlationId",
    "causationId",
    "producer",
    "payload"
  ],
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid"
    },
    "aggregateId": {
      "type": "string",
      "format": "uuid"
    },
    "aggregateVersion": {
      "const": 1
    },
    "eventType": {
      "const": "CouponRedeemed"
    },
    "schemaVersion": {
      "const": 1
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "correlationId": {
      "type": "string",
      "format": "uuid"
    },
    "causationId": {
      "type": "string",
      "format": "uuid"
    },
    "producer": {
      "const": "offers"
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reservationId",
        "code",
        "discount",
        "mode"
      ],
      "properties": {
        "reservationId": {
          "type": "string",
          "format": "uuid"
        },
        "code": {
          "type": "string",
          "pattern": "^[A-Z0-9]{3,24}$"
        },
        "discount": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "amount",
            "currency"
          ],
          "properties": {
            "amount": {
              "type": "string",
              "pattern": "^[0-9]+\\.[0-9]{2}$"
            },
            "currency": {
              "const": "INR"
            }
          }
        },
        "mode": {
          "const": "MOCK"
        }
      }
    }
  },
  "title": "CouponRedeemed v1 — platform campaign reservation-time redemption"
}
