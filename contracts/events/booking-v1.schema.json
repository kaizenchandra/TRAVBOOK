{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"urn:travbook:events:booking:v1",
  "title":"Durable booking intent events (local durable delivery)",
  "type":"object","additionalProperties":false,
  "required":["eventId","eventType","schemaVersion","aggregateId","aggregateVersion","occurredAt","correlationId","causationId","producer","mode","payload"],
  "properties":{
    "eventId":{"type":"string","format":"uuid"},
    "eventType":{"enum":["BookingCreated","BookingValidationStarted","BookingAwaitingPayment","BookingValidationRetryScheduled","BookingManualReviewRequired","BookingValidationRejected"]},
    "schemaVersion":{"const":1},"aggregateId":{"type":"string","format":"uuid"},"aggregateVersion":{"type":"integer","minimum":1},
    "occurredAt":{"type":"string","format":"date-time"},"correlationId":{"type":"string","format":"uuid"},"causationId":{"type":"string","format":"uuid"},
    "producer":{"const":"booking"},"mode":{"const":"MOCK"},
    "payload":{"type":"object","additionalProperties":false,"required":["bookingId","status","failureCode"],
      "properties":{"bookingId":{"type":"string","format":"uuid"},"status":{"enum":["CREATED","VALIDATING","AWAITING_PAYMENT","REQUIRES_REQUOTE","INVENTORY_UNAVAILABLE","EXPIRED","MANUAL_REVIEW"]},"failureCode":{"type":["string","null"]}}}
  }
}
