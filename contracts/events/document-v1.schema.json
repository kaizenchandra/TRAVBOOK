{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:travbook:events:document:v1",
  "title": "MOCK document creation (outbox, publication pending)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "eventId",
    "eventType",
    "schemaVersion",
    "aggregateId",
    "aggregateVersion",
    "occurredAt",
    "correlationId",
    "causationId",
    "producer",
    "mode",
    "payload"
  ],
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid"
    },
    "eventType": {
      "const": "MockDocumentCreated"
    },
    "schemaVersion": {
      "const": 1
    },
    "aggregateId": {
      "type": "string",
      "format": "uuid"
    },
    "aggregateVersion": {
      "const": 1
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "correlationId": {
      "type": "string",
      "format": "uuid"
    },
    "causationId": {
      "type": "string",
      "format": "uuid"
    },
    "producer": {
      "const": "trips"
    },
    "mode": {
      "const": "MOCK"
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "documentId",
        "bookingId",
        "checkoutId",
        "kind",
        "sha256"
      ],
      "properties": {
        "documentId": {
          "type": "string",
          "format": "uuid"
        },
        "bookingId": {
          "type": "string",
          "format": "uuid"
        },
        "checkoutId": {
          "type": "string",
          "format": "uuid"
        },
        "kind": {
          "const": "MOCK_CONFIRMATION_SUMMARY"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    }
  }
}
