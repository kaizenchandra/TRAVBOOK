{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "eventId",
    "aggregateId",
    "aggregateVersion",
    "eventType",
    "schemaVersion",
    "occurredAt",
    "correlationId",
    "causationId",
    "producer",
    "mode",
    "payload"
  ],
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid"
    },
    "aggregateId": {
      "type": "string",
      "format": "uuid"
    },
    "aggregateVersion": {
      "type": "integer",
      "minimum": 1
    },
    "eventType": {
      "enum": [
        "DemoOperationQueued",
        "DemoOperationClaimed",
        "DemoOperationUpdated"
      ]
    },
    "schemaVersion": {
      "const": 1
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "correlationId": {
      "type": "string",
      "format": "uuid"
    },
    "causationId": {
      "type": "string",
      "format": "uuid"
    },
    "producer": {
      "const": "simulation"
    },
    "mode": {
      "const": "MOCK"
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "status",
        "attempts"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "EMAIL",
            "SMS",
            "PRIVACY_EXPORT",
            "PRIVACY_ERASURE"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "QUEUED",
            "RUNNING",
            "RETRY",
            "SIMULATED_DELIVERED",
            "SIMULATED_REVIEW_REQUIRED",
            "FAILED"
          ]
        },
        "attempts": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        }
      }
    }
  }
}
