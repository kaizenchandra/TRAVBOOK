{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "eventId",
    "aggregateId",
    "aggregateVersion",
    "eventType",
    "schemaVersion",
    "occurredAt",
    "correlationId",
    "causationId",
    "producer",
    "mode",
    "payload"
  ],
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid"
    },
    "aggregateId": {
      "type": "string",
      "format": "uuid"
    },
    "aggregateVersion": {
      "type": "integer",
      "minimum": 1
    },
    "eventType": {
      "enum": [
        "MockFlightQuoteCreated",
        "MockFlightReservationUpdated"
      ]
    },
    "schemaVersion": {
      "const": 1
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "correlationId": {
      "type": "string",
      "format": "uuid"
    },
    "causationId": {
      "type": "string",
      "format": "uuid"
    },
    "producer": {
      "const": "flightprovider"
    },
    "mode": {
      "const": "MOCK"
    },
    "payload": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "total"
          ],
          "properties": {
            "total": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "amount",
                "currency"
              ],
              "properties": {
                "amount": {
                  "type": "string",
                  "pattern": "^[0-9]+\\.[0-9]{2}$"
                },
                "currency": {
                  "const": "INR"
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "reservation",
            "payment",
            "ticket",
            "refund",
            "checkedInCount"
          ],
          "properties": {
            "reservation": {
              "enum": [
                "RESERVED",
                "CANCELLED"
              ]
            },
            "payment": {
              "enum": [
                "UNPAID",
                "DECLINED",
                "CAPTURED",
                "REFUNDED"
              ]
            },
            "ticket": {
              "enum": [
                "NOT_ISSUED",
                "ISSUED",
                "REJECTED",
                "VOID"
              ]
            },
            "refund": {
              "enum": [
                "NONE",
                "PENDING",
                "COMPLETED"
              ]
            },
            "checkedInCount": {
              "type": "integer",
              "minimum": 0,
              "maximum": 6
            }
          }
        }
      ]
    }
  }
}
