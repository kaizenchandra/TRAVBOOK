# Local-only sample database; never use these credentials for a shared environment.
DATABASE_URL=jdbc:postgresql://127.0.0.1:54329/travbook
DATABASE_USERNAME=travbook
DATABASE_PASSWORD=local-only-travbook
INTEGRATION_MODE=MOCK
BOOKING_WORKER_ENABLED=true
BOOKING_EVENTS_ENABLED=true
BOOKING_CHECKOUT_ENABLED=true
BOOKING_CANCELLATION_ENABLED=true
REFUND_WORKER_ENABLED=true
# Rail workflow controls; pausing preserves durable work and provider receipts.
RAIL_TICKET_WORKER_ENABLED=true
RAIL_TICKET_POLL_MS=300
API_URL=http://127.0.0.1:8080
# For the local test provider use SPRING_PROFILES_ACTIVE=local-oidc and compose identity.
# External identity requires the oidc profile and values from an authorized provider.
# OIDC_ISSUER=https://your-authorized-issuer.example
# OIDC_CLIENT_ID=your-client-id
# OIDC_CLIENT_SECRET=configure-through-your-secret-manager
# WEB_ORIGIN=https://your-authorized-web-origin.example
# SESSION_COOKIE_SECURE=true
OIDC_AUDIENCE=travbook-api

# Durable MOCK bus, holiday and cab fulfilment
JOURNEY_WORKER_ENABLED=true
JOURNEY_POLL_MS=300

# Partial cancellation, replacement and package milestone worker
JOURNEY_CARE_WORKER_ENABLED=true
JOURNEY_CARE_POLL_MS=300

# Explicit local dummy API sandbox; never enables real integrations.
DEMO_APIS_ENABLED=true
DEMO_WORKER_ENABLED=true
DEMO_POLL_MS=1000

# Durable local lifecycle notifications. Delivery remains MOCK; no email/SMS leaves the app.
NOTIFICATION_WORKER_ENABLED=true
NOTIFICATION_POLL_MS=2000
