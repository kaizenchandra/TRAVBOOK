{
  "name": "travbook",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "dev": "npm run dev --workspace apps/web",
    "build": "npm run build --workspace apps/web",
    "typecheck": "npm run typecheck --workspace apps/web",
    "test": "npm run test --workspace apps/web",
    "test:e2e": "npm run test:e2e --workspace apps/web",
    "contract:generate": "openapi-typescript contracts/openapi.json -o apps/web/src/lib/api/schema.d.ts",
    "contract:check": "node scripts/check-contract.mjs",
    "requirements:generate": "node scripts/requirements.mjs",
    "requirements:check": "node scripts/requirements.mjs --check",
    "requirements:test": "node --test scripts/requirement-mappings.test.mjs",
    "contract:lint": "redocly lint contracts/openapi.json",
    "contract:test": "node --test scripts/contract-compatibility.test.mjs scripts/generator-compatibility.test.mjs",
    "postinstall": "node scripts/patch-redocly-minimatch.cjs"
  },
  "devDependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "openapi-typescript": "7.13.0",
    "@redocly/cli": "2.72.1"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "overrides": {
    "openapi-typescript": {
      "@redocly/openapi-core": {
        ".": "1.34.22",
        "minimatch": "11.0.1"
      }
    }
  }
}
